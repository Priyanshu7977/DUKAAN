rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'dukaancreate@gmail.com');
      allow update, delete: if request.auth != null && request.auth.token.email == 'dukaancreate@gmail.com';
    }
    match /inventory_overrides/{productId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
